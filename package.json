{
  "name": "drucker",
  "version": "3.1.0",
  "description": "A new website for a new future.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git@github.com:catchdigital/drucker.git"
  },
  "author": "Alberto Contreras <a.contreras@catchdigital.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/catchdigital/drucker/issues"
  },
  "homepage": "https://github.com/catchdigital/drucker/blob/develop/README.md",
  "scripts": {
    "start": "npm run develop",
    "dev": "npm run watch",
    "develop": "concurrently --raw \"npm run watch\" \"npm run storybook\"",
    "watch": "webpack --watch --progress --config ./webpack/webpack.dev.js",
    "build:storybook": "storybook build -c .storybook -o ./docroot/storybook",
    "build": "webpack --config ./webpack/webpack.dev.js",
    "build:prod": "webpack --config ./webpack/webpack.prod.js",
    "storybook": "storybook dev -p 6006",
    "postinstall": "patch-package",
    "lint": "eslint --fix --ext .js,.jsx ./docroot/themes/custom/sideshow/components",
    "test": "jest --coverage",
    "build:stories": "drush @local --uri https://sideshow.localhost storybook:generate-all-stories",
    "watch:stories": "chokidar './docroot/themes/custom/sideshow/**/*.stories.twig' -c \"drush @local --uri https://sideshow.localhost storybook:generate-stories ${echo {path} | sed 's|docroot/||'}\""
  },
  "dependencies": {
    "catchify-core": "^4.1.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.23.10",
    "@babel/preset-env": "^7.23.9",
    "@chromatic-com/storybook": "^1.6.1",
    "@storybook/addon-essentials": "^8.2.6",
    "@storybook/addon-links": "^8.2.6",
    "@storybook/addon-webpack5-compiler-swc": "^1.0.5",
    "@storybook/blocks": "^8.2.6",
    "@storybook/server": "^8.2.6",
    "@storybook/server-webpack5": "^8.2.6",
    "@storybook/test": "^8.2.6",
    "@storybook/web-components": "^8.2.6",
    "@storybook/web-components-webpack5": "^8.2.6",
    "@svgr/webpack": "^6.2.1",
    "babel-loader": "^8.2.4",
    "babel-preset-minify": "^0.5.2",
    "chokidar-cli": "^3.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^6.7.1",
    "dotenv-webpack": "^7.1.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-yml": "^1.12.2",
    "eslint-webpack-plugin": "^4.0.1",
    "file-loader": "^6.2.0",
    "html-bundler-webpack-plugin": "^3.4.12",
    "html-webpack-plugin": "^5.5.0",
    "imagemin-webpack-plugin": "^2.4.2",
    "lit": "^3.1.4",
    "mini-css-extract-plugin": "^2.8.0",
    "node-sass-glob-importer": "^5.3.3",
    "postcss-loader": "^8.1.0",
    "raw-loader": "^4.0.2",
    "sass-loader": "^14.1.0",
    "storybook": "^8.2.6",
    "style-loader": "^3.3.1",
    "stylelint-webpack-plugin": "^5.0.0",
    "svg-sprite-loader": "^6.0.11",
    "webpack": "^5.90.1",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.7.4"
  }
}
